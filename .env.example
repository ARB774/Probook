# Pooled Neon connection string for the application runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct Neon connection string for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Vercel Integration may provide this variable automatically.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Resend API key for real email delivery.
RESEND_API_KEY="re_xxxxxxxxx"

# Sender address on a domain verified in Resend.
RESEND_FROM_EMAIL="ProBook <prompts@example.com>"
