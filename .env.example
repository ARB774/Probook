# Pooled Neon connection string for the application runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional local PostgreSQL used by the local-only /view-db tool.
LOCAL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/probook"

# Direct Neon connection string for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js secret used to sign and encrypt login sessions.
# Generate a random value with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# Neon Vercel Integration may provide this variable automatically.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
