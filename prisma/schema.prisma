generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PRIVATE
  PUBLIC
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  notes     Note[]
  prompts   Txt[]
  votes     Vote[]
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Txt {
  id          String     @id @default(cuid())
  ownerId     String
  title       String
  content     String
  description String?
  categoryId  String
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags        Tag[]
  votes       Vote[]

  @@index([ownerId, updatedAt])
  @@index([visibility, createdAt])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  promptId  String
  value     Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Txt      @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@index([promptId])
  @@index([userId])
}

model Category {
  id       String @id @default(cuid())
  category String @unique
  prompts  Txt[]
}

model Tag {
  id      String @id @default(cuid())
  name    String @unique
  prompts Txt[]
}

model Friend {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}
